---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index?: number;
}

const { project, index } = Astro.props;
---

<article class="project-card">
  <div class="card-top">
    {index !== undefined && (
      <span class="project-number">
        {String(index + 1).padStart(2, "0")}
      </span>
    )}

    <span
      class:list={[
        "status",
        {
          done: project.status === "Completed",
          improving: project.status === "Improving",
          wip: project.status === "Work in progress",
        },
      ]}
    >
      {project.status}
    </span>
  </div>

  {
    project.slug === "nitrogen-tank-holder" ? (
<div
  class="card-image"
  style="padding: 0; overflow: hidden; border-style: solid; background: #ffffff; display: flex; align-items: center; justify-content: center;"
>
  <img
    src="/images/projects/nitrogen-tank-holder/tankfullassembly.png"
    alt="Full CAD assembly of the nitrogen tank holder"
    style="display: block; width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain;"
  />
</div>
    ) : project.slug === "magnetic-marble-maze" ? (
<div
  class="card-image"
  style="padding: 0; overflow: hidden; border-style: solid; background: #ffffff; display: flex; align-items: center; justify-content: center;"
>
  <img
    src="/images/projects/magnetic-marble-maze/completedmilestone4.jpg"
    alt="Completed Magnetic Marble Maze prototype"
    style="display: block; width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain;"
  />
</div>
    ) : project.slug === "titan-axial-compressor" ? (
<div
  class="card-image"
  style="padding: 0; overflow: hidden; border-style: solid; background: #ffffff; display: flex; align-items: center; justify-content: center;"
>
  <img
    src="/images/projects/titan-axial-compressor/full-stage-velocity-vectors.png"
    alt="Titan axial compressor full stage with velocity vectors"
    style="display: block; width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain;"
  />
</div>
    ) : project.slug === "lox-level-sensor" ? (
<div
  class="card-image"
  style="display: flex; align-items: center; justify-content: center; background: #f4f8fc; border-style: solid;"
>
  <span
    style="font-size: 3rem; font-weight: 800; letter-spacing: 0.08em; color: var(--accent); line-height: 1;"
  >
    WIP
  </span>
</div>
    ) : (
      <div class="card-image">
        <strong>PROJECT IMAGE</strong>
        <small>
          Replace with CAD, hardware, simulation, or final-product imagery.
        </small>
      </div>
    )
  }

  <p class="eyebrow">{project.category}</p>

  <h2>{project.shortTitle}</h2>

  <p>{project.summary}</p>

  <div class="tags">
    {project.tools.map((tool) => <span>{tool}</span>)}
  </div>

  <a class="text-link" href={`/projects/${project.slug}/`}>
    View project →
  </a>
</article>