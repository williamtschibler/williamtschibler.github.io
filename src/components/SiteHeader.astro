---
const pathname = Astro.url.pathname;

const links = [
  ["/", "Home"],
  ["/projects/", "Projects"],
  ["/experience/", "Experience"],
  ["/about/", "About"],
  ["/resume/", "Résumé"],
  ["/contact/", "Contact"],
];

const active = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname.startsWith(href);
---

<header class="site-header">
  <nav class="nav-container" aria-label="Main navigation">

    <a class="site-brand" href="/" aria-label="William T. Schibler homepage">
      <span class="logo" aria-hidden="true">WS</span>

      <span class="brand-copy">
        <span class="brand-name">William T. Schibler</span>
<span class="brand-role">
  Mechanical Engineering · Aerospace Engineering
</span>      </span>
    </a>

    <div class="nav-links">
      {
        links.map(([href, label]) => (
          <a
            href={href}
            class:list={{ active: active(href) }}
          >
            {label}
          </a>
        ))
      }
    </div>

  </nav>
</header>