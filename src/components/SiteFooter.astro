---
const currentYear = new Date().getFullYear();

interface Props {
    backgroundImage?: string;
}

const { backgroundImage } = Astro.props;
const footerClass = backgroundImage ? "site-footer has-background-image" : "site-footer";
---

<footer class={footerClass}>
    <div class="footer-main">
        <div class="footer-brand">
            <a class="footer-identity" href="/" aria-label="William T. Schibler homepage">
                <span class="footer-logo" aria-hidden="true">WS</span>

                <span class="footer-brand-copy">
                    <strong>William T. Schibler</strong>
                    <span>Mechanical Engineering · Aerospace Engineering</span>
                </span>
            </a>

            <p>Northeastern University</p>
        </div>

        <nav class="footer-column" aria-label="Footer navigation">
            <h2>Navigation</h2>

            <div class="footer-links">
    <a href="/">Home</a>
    <a href="/projects/">Projects</a>
    <a href="/experience/">Experience</a>

    <a href="/about/">About</a>
    <a href="/resume/">Résumé</a>
    <a href="/contact/">Contact</a>
</div>
        </nav>

        <div class="footer-column">
            <h2>Contact</h2>

            <div class="footer-social">
                <a
                    href="https://www.linkedin.com/in/william-schibler"
                    target="_blank"
                    rel="noreferrer"
                >
                    LinkedIn
                </a>

                <a
                    href="https://github.com/williamtschibler"
                    target="_blank"
                    rel="noreferrer"
                >
                    GitHub
                </a>

                <a href="mailto:schibler.w@northeastern.edu">
                    Email
                </a>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <p>Boston, Massachusetts · Northeastern University</p>
        <p>© {currentYear} William T. Schibler. All rights reserved.</p>
    </div>
</footer>
