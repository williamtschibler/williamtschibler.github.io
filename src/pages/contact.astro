---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | William Schibler">
    <section class="page-hero">
        <div class="page-container">
            <p class="eyebrow">Contact</p>
            <h1>Let’s connect.</h1>
            <p class="page-intro">
                This page will contain your professional email,
                LinkedIn profile, GitHub profile, and résumé.
            </p>
        </div>
    </section>

    <section class="section">
        <div class="contact-card">
            <h2>Contact information</h2>
            <p>
                We will add your real links after confirming the page structure
                and deciding what information you want publicly visible.
            </p>
        </div>
    </section>
</BaseLayout>
