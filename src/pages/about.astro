---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | William Schibler">
    <section class="page-hero">
        <div class="page-container">
            <p class="eyebrow">About</p>
            <h1>Engineering through analysis, design, and testing.</h1>
            <p class="page-intro">
                I am a Mechanical Engineering undergraduate at Northeastern
                University with an Aerospace Engineering minor.
            </p>
        </div>
    </section>

    <section class="section article-content">
        <h2>Background</h2>
        <p>
            My interests include propulsion, turbomachinery, computational
            fluid dynamics, CAD, manufacturing, and experimental testing.
            I enjoy taking a technical problem from initial calculations
            through modeling, simulation, fabrication, and evaluation.
        </p>

        <h2>What I am building</h2>
        <p>
            This portfolio documents the design process behind my projects,
            including the requirements, calculations, decisions, results,
            setbacks, and lessons learned—not only the final product.
        </p>

        <h2>Current focus</h2>
        <p>
            My current work emphasizes aerospace propulsion, fluid systems,
            engineering analysis, and hands-on test and manufacturing experience.
        </p>
    </section>
</BaseLayout>
