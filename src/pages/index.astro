---
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredProjects = [
    {
        title: "Axial Compressor Stage",
        category: "CFD · Turbomachinery",
        description:
            "Designed and analyzed a rotor-stator compressor stage using velocity triangles, CAD, meshing, and ANSYS Fluent.",
        href: "/projects/axial-compressor/",
        tools: "ANSYS Fluent · SolidWorks · MATLAB",
    },
    {
        title: "Titan Atmosphere Analysis",
        category: "Research · Atmospheric Modeling",
        description:
            "Evaluated Titan atmospheric properties and developed engineering inputs for propulsion-related calculations.",
        href: "/projects/titan-atmosphere/",
        tools: "MATLAB · Thermodynamics · Data Analysis",
    },
    {
        title: "Liquid Rocket Engine Team",
        category: "Propulsion · Experimental Systems",
        description:
            "Contributed to test-stand hardware, operations, fittings, and cryogenic instrumentation concepts.",
        href: "/projects/rocket-engine-team/",
        tools: "Test Operations · CAD · Hardware Integration",
    },
];
---

<BaseLayout title="William Schibler | Engineering Portfolio">
    <section class="hero">
        <div class="page-container">
            <p class="eyebrow">
                Mechanical Engineering · Aerospace Engineering
            </p>

            <h1>William Schibler</h1>

            <p class="hero-description">
                Engineering student focused on propulsion, fluid systems,
                computational analysis, and hands-on design.
            </p>

            <div class="button-row">
                <a class="button button-primary" href="/projects/">
                    View Projects
                </a>

                <a class="button button-secondary" href="/about/">
                    About Me
                </a>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-heading">
            <p class="section-label">Selected Work</p>
            <h2>Featured engineering projects</h2>
            <p>
                A selection of analytical, computational, and hands-on work.
                Each card links to a separate project page.
            </p>
        </div>

        <div class="project-grid">
            {
                featuredProjects.map((project, index) => (
                    <article class="project-card">
                        <p class="project-number">
                            {String(index + 1).padStart(2, "0")}
                        </p>
                        <p class="project-type">{project.category}</p>
                        <h3>{project.title}</h3>
                        <p>{project.description}</p>
                        <p class="tools">{project.tools}</p>
                        <a class="text-link" href={project.href}>
                            View project →
                        </a>
                    </article>
                ))
            }
        </div>

        <div class="section-action">
            <a class="button button-secondary" href="/projects/">
                See all projects
            </a>
        </div>
    </section>

    <section class="section section-bordered">
        <div class="section-heading">
            <p class="section-label">Technical Focus</p>
            <h2>Analysis, design, and testing</h2>
        </div>

        <div class="skills-grid">
            <div class="skill-card">
                <h3>Analysis</h3>
                <p>
                    Fluid mechanics, thermodynamics, compressible flow,
                    flight performance, and structural mechanics.
                </p>
            </div>

            <div class="skill-card">
                <h3>Software</h3>
                <p>
                    ANSYS Fluent, SolidWorks, MATLAB, GitHub, and
                    engineering data visualization.
                </p>
            </div>

            <div class="skill-card">
                <h3>Hands-on Work</h3>
                <p>
                    Prototyping, fabrication, troubleshooting,
                    test support, and makerspace equipment.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>
