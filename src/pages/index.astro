---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";

/*
 * Always show up to four projects.
 * If no project is marked "featured", fall back to the first four projects.
 */
const markedFeatured = projects.filter((project) => project.featured);
const visibleProjects =
    markedFeatured.length > 0
        ? markedFeatured.slice(0, 4)
        : projects.slice(0, 4);

const capabilities = [
    {
        title: "Aerospace and Fluid Systems",
        icon: "rocket",
        items: [
            "Rocket fluid-system testing",
            "Compressor and flow analysis",
            "Thermofluid calculations",
            "Aircraft performance analysis",
        ],
    },
    {
        title: "Design and Analysis",
        icon: "cube",
        items: [
            "CAD modeling",
            "CFD and simulation",
            "System modeling",
            "Engineering data analysis",
        ],
    },
    {
        title: "Manufacturing and Hardware",
        icon: "gear",
        items: [
            "Machining and fabrication",
            "Assembly and integration",
            "Welding",
            "Prototype development",
        ],
    },
    {
        title: "Testing and Experimentation",
        icon: "flask",
        items: [
            "Data collection",
            "Instrumentation",
            "Validation and iteration",
            "Experimental methods",
        ],
    },
    {
        title: "Embedded Systems and Programming",
        icon: "code",
        items: [
            "Electronics and sensors",
            "Microcontrollers",
            "Firmware and software",
            "Data logging and control",
        ],
    },
];

const capabilityIcons = {
    rocket: `
    <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z"/>
    <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.87 12.87 0 0 1 22 2c0 2.72-.78 7.5-6.05 11A22.35 22.35 0 0 1 12 15Z"/>
    <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
    <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
    <circle cx="16" cy="8" r="1"/>
    `, 
    cube: `
        <path d="m12 2 9 5-9 5-9-5 9-5Z"/>
        <path d="m3 7 9 5v10l-9-5V7Z"/>
        <path d="m21 7-9 5v10l9-5V7Z"/>
    `,
    gear: `
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1A1.7 1.7 0 0 0 9 4.6 1.7 1.7 0 0 0 10 3v-.2h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"/>
    `,
    flask: `
        <path d="M9 2h6"/>
        <path d="M10 2v6l-5 9a3 3 0 0 0 2.6 4.5h8.8A3 3 0 0 0 19 17l-5-9V2"/>
        <path d="M8 14h8"/>
        <path d="M9 17h6"/>
    `,
    code: `
        <path d="m8 9-4 3 4 3"/>
        <path d="m16 9 4 3-4 3"/>
        <path d="m14 5-4 14"/>
    `,
};
---

<BaseLayout
    title="William Schibler | Engineering Portfolio"
    footerBackgroundImage="/images/hero-aerospace.svg"
>
    <section class="home-hero">
        <div class="home-hero-inner">
            <div class="home-hero-copy">
    <div class="hero-identity">
        <p class="hero-name">William T. Schibler</p>

        <p class="hero-study">
            Mechanical Engineering Student · Aerospace Engineering Minor
        </p>
    </div>

    <h1 class="hero-title">
        Designing, Building,<br />
        and Testing <span>Aerospace Systems.</span>
    </h1>

    <p class="home-hero-description">
        I am a Mechanical Engineering student at Northeastern University pursuing
        an Aerospace minor. My work combines aerospace propulsion and 
        fluid system analysis with computational modeling, hands-on design, manufacturing, and 
        experimental testing.
    </p>

    <div class="button-row">
        <a class="button button-primary" href="/projects/">
            View Projects →
        </a>

        <a class="button button-secondary" href="/resume/">
            View Résumé
        </a>

        <a class="button button-plain" href="/contact/">
            Contact Me →
        </a>
    </div>
</div>

            <!-- Controlled vector line art—not a generated PNG. -->
            <div class="hero-technical-art" aria-hidden="true">
                <svg
                    viewBox="0 0 760 420"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <g
                        stroke="currentColor"
                        stroke-width="1.5"
                        vector-effect="non-scaling-stroke"
                    >
                        <ellipse cx="164" cy="210" rx="112" ry="142" />
                        <ellipse cx="164" cy="210" rx="76" ry="98" />
                        <ellipse cx="164" cy="210" rx="22" ry="30" />

                        <path d="M164 68L610 108" />
                        <path d="M164 352L610 312" />

                        <ellipse cx="610" cy="210" rx="84" ry="102" />
                        <ellipse cx="610" cy="210" rx="50" ry="62" />
                        <ellipse cx="610" cy="210" rx="16" ry="20" />

                        <path d="M278 80V340" />
                        <path d="M386 90V330" />
                        <path d="M494 100V320" />

                        <path d="M164 68C236 118 236 302 164 352" />
                        <path d="M278 80C334 126 334 294 278 340" />
                        <path d="M386 90C432 132 432 288 386 330" />
                        <path d="M494 100C532 138 532 282 494 320" />

                        <path d="M112 112L216 308" />
                        <path d="M90 156L238 264" />
                        <path d="M82 210H246" />
                        <path d="M90 264L238 156" />
                        <path d="M112 308L216 112" />
                    </g>
                </svg>
            </div>
        </div>
    </section>

    <!-- This section is deliberately hard-coded into the homepage skeleton. -->
    <section class="home-projects" id="selected-work">
        <div class="wide-section">
            <div class="section-heading section-heading-row">
                <div>
                    <h2>Featured Engineering Projects</h2>
                </div>

                
            </div>

            <div class="project-grid">
             {
              visibleProjects.map((project, index) => (
              <ProjectCard project={project} index={index} />
              ))
            }
            </div>

            <div class="button-row" style="justify-content: center;">
                <a class="button button-outline-blue" href="/projects/">
                    View All Projects →
                </a>
            </div>
        </div>
        
    </section>

    <section class="home-capabilities">
        <div class="wide-section">
            <div class="section-heading">
                <h2>Experience</h2>
            </div>

            <div class="capability-grid">
                {
                    capabilities.map((capability) => (
                        <article class="capability-card">
                            <div class="capability-card-heading">
    <div class="capability-icon" aria-hidden="true">
        <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <Fragment set:html={capabilityIcons[capability.icon]} />
        </svg>
    </div>

    <h3>{capability.title}</h3>
</div>

<ul>
    {capability.items.map((item) => <li>{item}</li>)}
</ul>
                        </article>
                    ))
                }
            </div>
            <div class="button-row" style="justify-content: center;">
    <a class="button button-outline-blue" href="/experience/">
        View My Experience →
    </a>
</div>
        </div>
    </section>

    <section class="home-about">
        <div class="wide-section home-about-grid">
            <div class="home-about-copy">
                <h2>About Me</h2>

                <p>
                    I am a Mechanical Engineering Student at Northeastern University with a passion for 
                    learning, improving, and taking on new challenges. I enjoy working on projects that
                    combine technical analysis with hands-on design, frabrication, and testing.
                </p>

                <p>
                    I am particularly interested in aerospace engineering and look to apply my 
                    knowledge and experience to develop practical solutions, contribute to meaningful 
                    projects, and help advance the field.
                </p>

                <a class="button button-outline-blue" href="/about/">
                    Learn More About Me →
                </a>
            </div>

            <div class="home-about-portrait">
    <div class="portrait-placeholder" style="padding: 0; overflow: hidden; border: 4px solid var(--accent);">
        <img
            src="/images/headshot.jpg"
            alt="Professional portrait of William Schibler"
            style="display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 20%;"
        />
    </div>

    <h3>
        Driven by Curiosity.<br />
        Built on Fundamentals.
    </h3>
</div>

            <div class="home-values">
                <article>
                    <div class="value-icon">◎</div>
                    <div>
                        <h3>Mission Driven</h3>
                        <p>
                            I carry out all my projects with a clear objective, careful 
                            attention to detail, and a focus on producing meaningful results.                        </p>
                    </div>
                </article>

                <article>
                    <div class="value-icon">▤</div>
                    <div>
                        <h3>Continuous Learner</h3>
                        <p>
                            I am always looking for opportunities to 
                            explore new tools, skills, and ideas to both solve engineering challenges or improve
                            myself.
                        </p>
                    </div>
                </article>

                <article>
                    <div class="value-icon">◯</div>
                    <div>
                        <h3>Team Collaborator</h3>
                        <p>
                            I am an open communicator who is capable of outlining objectives, 
                            hearing different perspectives, and delegating work, all in order to achieve
                            the team's goals.
                        </p>
                    </div>
                </article>
            </div>
        </div>
    </section>
</BaseLayout>
