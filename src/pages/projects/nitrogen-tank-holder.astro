---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Hot Fire Test Stand Nitrogen Tank Holder"
  category="Mechanical Design · CAD · Assembly"
  status="Completed"
  summary="A two-person hardware project involving measurements, CAD modeling, hardware selection, ordering, and installation on a rocket-engine test stand."
  tools={["SolidWorks", "Water Jet", "Hand Tools"]}
  team="Two-person project"
>
  <div class="case-study-page">
    <section class="case-study-card context-card">
      <div class="context-icon-slot" aria-label="Nitrogen tank pressure system icon">
        <img
          src="/images/projects/nitrogen-tank-holder/nitrogen_tank_and_pressure_gauge_icon.png"
          alt=""
        />
      </div>

      <div class="context-copy">
        <h2>Project Context</h2>
        <p>
          In conducting water flow tests and general hotfires, the AerospaceNU: Liquid Rocket Engine team
          pressurizes their flow system with a nitrogen tank. After the gas goes through a valve, it is contained in 
          a custom metal nitrogen tank. That tank can reach up to 1000 psig! It needed to be securely fastened to the test stand in 
          a convenient but safe manner.
        </p>
      </div>

      <div class="context-icon-slot" aria-label="Nitrogen tank mounting system icon">
        <img
          src="/images/projects/nitrogen-tank-holder/blue_nitrogen_tank_test_stand_icon.png"
          alt=""
        />
      </div>
    </section>

    <section class="case-study-card split-card">
      <div class="section-copy">
        <h2>Design Constraints and Measurement Process</h2>
        <p>
          A nitrogen tank needed to be fixed onto the stand in such a way that
          it wouldn't interfere with other parts of the flow system or pose any 
          safety hazards. After pitching some ideas to our team lead, 
          my partner and I got approval for an idea and began sketching it out.
        </p>
        <p>
          After sketching our design, we took measurements of the nitrogen tank and the beams 
          that would be supporting the tank fixtures. After taking and applying those measurements  
          to the sketch, we double-checked each other's measurements, and once the measurements were verified, 
          we began 3D modeling the final concept for the leader's approval.
        </p>
      </div>

      <div class="carousel" data-carousel>
        <div class="carousel-frame">
          <div class="carousel-slide is-active" data-slide>
            <img
              src="/images/projects/nitrogen-tank-holder/tankimageisometric.png"
              alt="Isometric CAD view of the nitrogen tank"
            />
            <div class="carousel-caption">Isometric Tank CAD View</div>
          </div>

          <div class="carousel-slide" data-slide>
            <img
              src="/images/projects/nitrogen-tank-holder/tankimagefront.png"
              alt="Front CAD view of the nitrogen tank"
            />
            <div class="carousel-caption">Front Tank CAD View</div>
          </div>

          <div class="carousel-slide" data-slide>
            <img
              src="/images/projects/nitrogen-tank-holder/tankimageside.png"
              alt="Side CAD view of the nitrogen tank"
            />
            <div class="carousel-caption">Side Tank CAD View</div>
          </div>

          <button class="carousel-arrow previous" type="button" data-previous aria-label="Previous design and measurement image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button class="carousel-arrow next" type="button" data-next aria-label="Next design and measurement image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>

        <div class="carousel-dots" aria-hidden="true">
          <span class="is-active" data-dot></span>
          <span data-dot></span>
          <span data-dot></span>
        </div>
      </div>
    </section>

    <section class="case-study-card split-card reverse-card">
      <div class="carousel" data-carousel>
        <div class="carousel-frame">
          <div class="carousel-slide is-active" data-slide>
            <img
              class="rotate-clockwise"
              src="/images/projects/nitrogen-tank-holder/topplateimage.png"
              alt="CAD view of the nitrogen tank top plate"
            />
            <div class="carousel-caption">Top Plate CAD Front View</div>
          </div>

          <div class="carousel-slide" data-slide>
            <img
              class="rotate-clockwise"
              src="/images/projects/nitrogen-tank-holder/bottomplateimage.png"
              alt="CAD view of the nitrogen tank bottom plate"
            />
            <div class="carousel-caption">Bottom Plate CAD Front View</div>
          </div>

          <div class="carousel-slide" data-slide>
            <img
              src="/images/projects/nitrogen-tank-holder/tankfullassembly.png"
              alt="Full CAD assembly of the nitrogen tank and support plates"
            />
            <div class="carousel-caption">Full CAD Assembly</div>
          </div>

          <button class="carousel-arrow previous" type="button" data-previous aria-label="Previous CAD and material image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button class="carousel-arrow next" type="button" data-next aria-label="Next CAD and material image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>

        <div class="carousel-dots" aria-hidden="true">
          <span class="is-active" data-dot></span>
          <span data-dot></span>
          <span data-dot></span>
        </div>
      </div>

      <div class="section-copy">
        <h2>CAD Development and Material Selection</h2>
        <p>
          Using SolidWorks, my teammate constructed the CAD designs that 
          we had measured for our tank supports while I researched aluminum sheets and pricing. 
          When showing the leader our initial designs and material costs, he asked us to find a way to lower 
          the price. Consequently, we redid some of our measurements and managed to reduce our required material volume
          by 72 in³.
        </p>
        <p>
          With our materials selected, we ordered several nuts, bolts, washers, and spacers for specific parts of 
          the support frame from McMaster. The diameter of all the bolts, nuts, and washers was the same, but 
          since the infrastructure varied across the different support points, the length of the bolts differed greatly.
          The variations also made the non-threaded spacers necessary.
        </p>
      </div>
    </section>

    <section class="case-study-card split-card">
      <div class="section-copy">
        <h2>Fabrication and Assembly</h2>
        <p>
          Once the different parts were ordered and delivered, it was 
          my job to waterjet the aluminum pieces. Taking my partner's 3D model, 
          I generated a design to cut out the aluminum sheet into our desired frames. 
          However, after cutting and attempting to install the frame, I found that the holes in the tank 
          and the supports were misaligned because I did not double-check my partner's 3D model. 
          Consequently, I had to make measurements by hand to drill new holes. 
          After doing this, my partner and I used the frame alignment to drill matching holes 
          into the steel structure and then install the tank and supports using the ordered bolts, 
          nuts, washers, and spacers.
        </p>
      </div>

      <div class="carousel" data-carousel>
        <div class="carousel-frame">
          <div class="carousel-slide is-active" data-slide>
            <img
              src="/images/projects/nitrogen-tank-holder/fabricationplate1.png"
              alt="Top plate after fabrication on a workbench"
            />
            <div class="carousel-caption">Top Plate After Fabrication</div>
          </div>

          <div class="carousel-slide" data-slide>
            <img
              src="/images/projects/nitrogen-tank-holder/fabricationplate2.png"
              alt="Bottom plate after fabrication on a workbench"
            />
            <div class="carousel-caption">Bottom Plate After Fabrication</div>
          </div>

          <div class="carousel-slide" data-slide>
            <div class="carousel-placeholder">
              Better image of full assembly pending
            </div>
          </div>

          <button class="carousel-arrow previous" type="button" data-previous aria-label="Previous fabrication and assembly image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button class="carousel-arrow next" type="button" data-next aria-label="Next fabrication and assembly image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>

        <div class="carousel-dots" aria-hidden="true">
          <span class="is-active" data-dot></span>
          <span data-dot></span>
          <span data-dot></span>
        </div>
      </div>
    </section>

    <section class="overall-section">
      <div class="overall-heading">
        <span></span>
        <h2>Overall</h2>
        <span></span>
      </div>

      <div class="overall-grid">
        <article class="overall-card">
          <h3>Results</h3>
          <p>
            The final design performed as expected with no performance issues and minimal excess material. The supports 
            have been used for multiple water flow tests and a hot fire.
          </p>
        </article>

        <article class="overall-card">
          <h3>My Contributions</h3>
          <p>
            Overall, my specific contributions involved idea 
            brainstorming, obtaining measurements, selecting and ordering materials, 
            machining the materials, troubleshooting the design, and installing the tank 
            and supports onto the stand.
          </p>
        </article>

        <article class="overall-card">
          <h3>Lessons Learned</h3>
          <p>
            From this project, I developed a better understanding of  
            how to select nuts and bolts, and I learned to always double-check not only my own work 
            but my peers' work as well. In the future, I will also 
            reduce material thickness, as the original thickness choice was an excessive 1/2 in.
          </p>
        </article>
      </div>
    </section>
  </div>
</ProjectLayout>

<style>
  .case-study-page {
    display: grid;
    gap: 30px;
  }

  .case-study-card {
    border: 1px solid #bfd2e5;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.72);
  }

  .context-card {
    display: grid;
    grid-template-columns: 150px minmax(0, 760px) 150px;
    align-items: center;
    justify-content: space-between;
    gap: 46px;
    min-height: 270px;
    padding: 46px 54px;
  }

  .context-copy {
    text-align: center;
  }

  .context-copy h2,
  .section-copy h2,
  .overall-heading h2,
  .overall-card h3 {
    color: var(--text);
  }

  .context-copy h2 {
    margin: 0 0 22px;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .context-copy p {
    margin: 0;
    text-align: justify;
    text-align-last: center;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .context-copy p + p {
    margin-top: 18px;
  }

  .context-icon-slot {
    display: grid;
    width: 160px;
    aspect-ratio: 1;
    place-items: center;
    justify-self: center;
    border: 8px solid #78aee8;
    border-radius: 14px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  .context-icon-slot img {
    width: 148px;
    height: 148px;
    object-fit: contain;
    display: block;
  }

  .context-card > .context-icon-slot:first-child {
    transform: translateX(28px);
  }

  .context-card > .context-icon-slot:last-child {
    transform: translateX(-28px);
  }

  .split-card {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    align-items: center;
    gap: 54px;
    padding: 28px 34px;
  }

  .reverse-card {
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
  }

  .section-copy {
    align-self: start;
    padding: 18px 14px;
  }

  .section-copy h2 {
    margin: 0 0 32px;
    font-size: clamp(1.9rem, 2.7vw, 2.7rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .section-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 1.06rem;
  }

  .section-copy p + p {
    margin-top: 30px;
  }

  .carousel {
    min-width: 0;
  }

  .carousel-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 7px solid var(--accent);
    border-radius: 17px;
    background: #eaf1f8;
  }

  .carousel-slide {
    display: none;
    width: 100%;
    height: 100%;
  }

  .carousel-slide.is-active {
    display: block;
  }

  .carousel-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #ffffff;
  }

  .carousel-slide img.rotate-clockwise {
    width: auto;
    height: 100%;
    max-width: 100%;
    margin: 0 auto;
    transform: rotate(90deg);
  }

  .carousel-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    padding: 24px;
    background:
      linear-gradient(135deg, rgba(20, 126, 223, 0.035), rgba(20, 126, 223, 0.09)),
      #eef4fa;
    color: #6f8297;
    font-weight: 750;
    text-align: center;
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    padding: 0;
    border: 1px solid #d5e0ea;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    color: var(--accent);
    cursor: pointer;
    transform: translateY(-50%);
    box-shadow: 0 3px 12px rgba(18, 32, 58, 0.12);
  }

  .carousel-arrow:hover {
    background: #ffffff;
  }

  .carousel-arrow svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .carousel-arrow.previous {
    left: 14px;
  }

  .carousel-arrow.next {
    right: 14px;
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 13px;
  }

  .carousel-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #cbd6e1;
  }

  .carousel-dots span.is-active {
    background: var(--accent);
  }

  .overall-section {
    padding-top: 4px;
  }

  .overall-heading {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin-bottom: 18px;
  }

  .overall-heading span {
    height: 2px;
    background: #a9c9e8;
  }

  .overall-heading h2 {
    margin: 0;
    font-size: clamp(1.8rem, 2.6vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.035em;
    text-align: center;
  }

  .overall-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .overall-card {
    min-height: 190px;
    padding: 28px 30px;
    border: 1px solid #91bae2;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.76);
  }

  .overall-card h3 {
    margin: 0 0 13px;
    font-size: 1.3rem;
  }

  .overall-card p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .context-card {
      grid-template-columns: 90px minmax(0, 1fr) 90px;
      gap: 26px;
      padding: 38px 30px;
    }

    .split-card,
    .reverse-card {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .reverse-card .carousel {
      order: 2;
    }

    .reverse-card .section-copy {
      order: 1;
    }
  }

  @media (max-width: 720px) {
    .case-study-page {
      gap: 20px;
    }

    .context-card {
      grid-template-columns: 1fr;
      gap: 20px;
      min-height: 0;
      padding: 30px 24px;
    }

    .context-icon-slot {
      display: none;
    }

    .context-copy p {
      text-align: left;
      text-align-last: auto;
    }

    .split-card,
    .reverse-card {
      padding: 20px;
    }

    .section-copy {
      padding: 6px 2px;
    }

    .section-copy h2 {
      margin-bottom: 20px;
    }

    .carousel-frame {
      border-width: 5px;
    }

    .carousel-arrow {
      width: 42px;
      height: 42px;
    }

    .overall-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(carousel.querySelectorAll<HTMLElement>("[data-dot]"));
    const previous = carousel.querySelector<HTMLButtonElement>("[data-previous]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-next]");

    let activeIndex = 0;

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === activeIndex;
        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", String(!active));
      });

      dots.forEach((dot, dotIndex) => {
        dot.classList.toggle("is-active", dotIndex === activeIndex);
      });
    };

    previous?.addEventListener("click", () => showSlide(activeIndex - 1));
    next?.addEventListener("click", () => showSlide(activeIndex + 1));

    showSlide(0);
  });
</script>