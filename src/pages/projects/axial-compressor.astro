---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Axial Compressor Stage"
  category="CFD · Turbomachinery"
  summary="Design and CFD analysis of a rotor-stator axial compressor stage."
  tools={["ANSYS Fluent", "SolidWorks", "MATLAB"]}
>
  <div class="case-study-page">
    <section class="case-study-card context-card">
      <div class="context-icon-slot" aria-label="Left context icon placeholder"><span>ICON</span></div>

      <div class="context-copy">
        <h2>Project Context</h2>
        <p>
          Design a single axial-compressor stage and evaluate its aerodynamic performance using analytical calculations and computational fluid dynamics.
        </p>
      </div>

      <div class="context-icon-slot" aria-label="Right context icon placeholder"><span>ICON</span></div>
    </section>
    <section class="case-study-card split-card">
      <div class="section-copy">
        <h2>Analytical Design and Blade Geometry</h2>
        <p>
          Document the velocity triangles, target flow turning, rotor and stator geometry, and the analytical calculations used to establish the stage design.
        </p>
        <p>
          Explain the major design constraints and the reasoning behind the selected blade angles, dimensions, and operating point.
        </p>
      </div>

      <div class="carousel" data-carousel>
        <div class="carousel-frame">
          <div class="carousel-slide is-active" data-slide>
            <div class="carousel-placeholder">Velocity triangle / design image 1</div>
          </div>
          <div class="carousel-slide" data-slide>
            <div class="carousel-placeholder">Blade geometry image 2</div>
          </div>
          <div class="carousel-slide" data-slide>
            <div class="carousel-placeholder">Analytical design image 3</div>
          </div>

          <button class="carousel-arrow previous" type="button" data-previous aria-label="Previous analytical compressor design image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button class="carousel-arrow next" type="button" data-next aria-label="Next analytical compressor design image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>

        <div class="carousel-dots" aria-hidden="true">
          <span class="is-active" data-dot></span>
          <span data-dot></span>
          <span data-dot></span>
        </div>
      </div>
    </section>
    <section class="case-study-card split-card reverse-card">
      <div class="carousel" data-carousel>
        <div class="carousel-frame">
          <div class="carousel-slide is-active" data-slide>
            <div class="carousel-placeholder">CAD / mesh image 1</div>
          </div>
          <div class="carousel-slide" data-slide>
            <div class="carousel-placeholder">Mesh quality image 2</div>
          </div>
          <div class="carousel-slide" data-slide>
            <div class="carousel-placeholder">Solver setup image 3</div>
          </div>

          <button class="carousel-arrow previous" type="button" data-previous aria-label="Previous compressor setup image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button class="carousel-arrow next" type="button" data-next aria-label="Next compressor setup image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>

        <div class="carousel-dots" aria-hidden="true">
          <span class="is-active" data-dot></span>
          <span data-dot></span>
          <span data-dot></span>
        </div>
      </div>

      <div class="section-copy">
        <h2>CAD, Meshing, and Solver Setup</h2>
        <p>
          Describe the CAD model, periodic-sector flow domain, mesh-development process, boundary conditions, rotating-reference treatment, turbulence model, and convergence strategy.
        </p>
        <p>
          Highlight the setup decisions that had the greatest effect on numerical stability and physical credibility.
        </p>
      </div>
    </section>
    <section class="case-study-card split-card">
      <div class="section-copy">
        <h2>CFD Results and Validation</h2>
        <p>
          Add only results that can be supported by converged, physically consistent calculations. Show pressure, temperature, velocity, or flow-angle behavior alongside the checks used to validate the solution.
        </p>
        <p>
          Document limitations, troubleshooting decisions, and any results that should not be treated as validated performance metrics.
        </p>
      </div>

      <div class="carousel" data-carousel>
        <div class="carousel-frame">
          <div class="carousel-slide is-active" data-slide>
            <div class="carousel-placeholder">CFD result image 1</div>
          </div>
          <div class="carousel-slide" data-slide>
            <div class="carousel-placeholder">CFD result image 2</div>
          </div>
          <div class="carousel-slide" data-slide>
            <div class="carousel-placeholder">Validation image 3</div>
          </div>

          <button class="carousel-arrow previous" type="button" data-previous aria-label="Previous CFD result image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button class="carousel-arrow next" type="button" data-next aria-label="Next CFD result image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>

        <div class="carousel-dots" aria-hidden="true">
          <span class="is-active" data-dot></span>
          <span data-dot></span>
          <span data-dot></span>
        </div>
      </div>
    </section>
    <section class="overall-section">
      <div class="overall-heading">
        <span></span>
        <h2>Overall</h2>
        <span></span>
      </div>

      <div class="overall-grid">
        <article class="overall-card">
          <h3>Results</h3>
          <p>Summarize the validated aerodynamic outcome of the stage and clearly separate confirmed performance from unresolved simulation behavior.</p>
        </article>

        <article class="overall-card">
          <h3>My Contributions</h3>
          <p>Add a precise explanation of your individual design, modeling, meshing, solver-setup, and analysis responsibilities.</p>
        </article>

        <article class="overall-card">
          <h3>Lessons Learned</h3>
          <p>Summarize the main technical lessons from the analytical design, CFD setup, troubleshooting, and validation process.</p>
        </article>
      </div>
    </section>
  </div>
</ProjectLayout>


<style>
  .case-study-page {
    display: grid;
    gap: 30px;
  }

  .case-study-card {
    border: 1px solid #bfd2e5;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.72);
  }

  .context-card {
    display: grid;
    grid-template-columns: 150px minmax(0, 760px) 150px;
    align-items: center;
    justify-content: space-between;
    gap: 46px;
    min-height: 270px;
    padding: 46px 54px;
  }

  .context-copy {
    text-align: center;
  }

  .context-copy h2,
  .section-copy h2,
  .overall-heading h2,
  .overall-card h3 {
    color: var(--text);
  }

  .context-copy h2 {
    margin: 0 0 22px;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .context-copy p {
    margin: 0;
    text-align: justify;
    text-align-last: center;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .context-copy p + p {
    margin-top: 18px;
  }

  .context-icon-slot {
    display: grid;
    width: 94px;
    aspect-ratio: 1;
    place-items: center;
    justify-self: center;
    border: 2px dashed #78aee8;
    border-radius: 14px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  .split-card {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    align-items: center;
    gap: 54px;
    padding: 28px 34px;
  }

  .reverse-card {
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
  }

  .section-copy {
    padding: 18px 14px;
  }

  .section-copy h2 {
    margin: 0 0 32px;
    font-size: clamp(1.9rem, 2.7vw, 2.7rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .section-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 1.06rem;
  }

  .section-copy p + p {
    margin-top: 30px;
  }

  .carousel {
    min-width: 0;
  }

  .carousel-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 7px solid var(--accent);
    border-radius: 17px;
    background: #eaf1f8;
  }

  .carousel-slide {
    display: none;
    width: 100%;
    height: 100%;
  }

  .carousel-slide.is-active {
    display: block;
  }

  .carousel-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #ffffff;
  }

  .carousel-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    padding: 24px;
    background:
      linear-gradient(135deg, rgba(20, 126, 223, 0.035), rgba(20, 126, 223, 0.09)),
      #eef4fa;
    color: #6f8297;
    font-weight: 750;
    text-align: center;
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    padding: 0;
    border: 1px solid #d5e0ea;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    color: var(--accent);
    cursor: pointer;
    transform: translateY(-50%);
    box-shadow: 0 3px 12px rgba(18, 32, 58, 0.12);
  }

  .carousel-arrow:hover {
    background: #ffffff;
  }

  .carousel-arrow svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .carousel-arrow.previous {
    left: 14px;
  }

  .carousel-arrow.next {
    right: 14px;
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 13px;
  }

  .carousel-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #cbd6e1;
  }

  .carousel-dots span.is-active {
    background: var(--accent);
  }

  .overall-section {
    padding-top: 4px;
  }

  .overall-heading {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin-bottom: 18px;
  }

  .overall-heading span {
    height: 2px;
    background: #a9c9e8;
  }

  .overall-heading h2 {
    margin: 0;
    font-size: clamp(1.8rem, 2.6vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.035em;
    text-align: center;
  }

  .overall-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .overall-card {
    min-height: 190px;
    padding: 28px 30px;
    border: 1px solid #91bae2;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.76);
  }

  .overall-card h3 {
    margin: 0 0 13px;
    font-size: 1.3rem;
  }

  .overall-card p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .context-card {
      grid-template-columns: 90px minmax(0, 1fr) 90px;
      gap: 26px;
      padding: 38px 30px;
    }

    .split-card,
    .reverse-card {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .reverse-card .carousel {
      order: 2;
    }

    .reverse-card .section-copy {
      order: 1;
    }
  }

  @media (max-width: 720px) {
    .case-study-page {
      gap: 20px;
    }

    .context-card {
      grid-template-columns: 1fr;
      gap: 20px;
      min-height: 0;
      padding: 30px 24px;
    }

    .context-icon-slot {
      display: none;
    }

    .context-copy p {
      text-align: left;
      text-align-last: auto;
    }

    .split-card,
    .reverse-card {
      padding: 20px;
    }

    .section-copy {
      padding: 6px 2px;
    }

    .section-copy h2 {
      margin-bottom: 20px;
    }

    .carousel-frame {
      border-width: 5px;
    }

    .carousel-arrow {
      width: 42px;
      height: 42px;
    }

    .overall-grid {
      grid-template-columns: 1fr;
    }
  }
</style>


<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(carousel.querySelectorAll<HTMLElement>("[data-dot]"));
    const previous = carousel.querySelector<HTMLButtonElement>("[data-previous]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-next]");

    let activeIndex = 0;

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === activeIndex;
        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", String(!active));
      });

      dots.forEach((dot, dotIndex) => {
        dot.classList.toggle("is-active", dotIndex === activeIndex);
      });
    };

    previous?.addEventListener("click", () => showSlide(activeIndex - 1));
    next?.addEventListener("click", () => showSlide(activeIndex + 1));

    showSlide(0);
  });
</script>
