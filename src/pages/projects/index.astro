---
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = [
    {
        title: "Axial Compressor Stage",
        category: "CFD · Turbomachinery",
        description:
            "Rotor-stator design, meshing, boundary-condition setup, and CFD analysis.",
        href: "/projects/axial-compressor/",
        tools: "ANSYS Fluent · SolidWorks · MATLAB",
    },
    {
        title: "Titan Atmosphere Analysis",
        category: "Research · Atmospheric Modeling",
        description:
            "Atmospheric-property research and engineering calculations for Titan.",
        href: "/projects/titan-atmosphere/",
        tools: "MATLAB · Thermodynamics · Data Analysis",
    },
    {
        title: "Liquid Rocket Engine Team",
        category: "Propulsion · Experimental Systems",
        description:
            "Test-stand hardware, operations, fittings, and cryogenic sensor concepts.",
        href: "/projects/rocket-engine-team/",
        tools: "Test Operations · CAD · Hardware Integration",
    },
];
---

<BaseLayout title="Projects | William Schibler">
    <section class="page-hero">
        <div class="page-container">
            <p class="eyebrow">Projects</p>
            <h1>Engineering work and technical case studies.</h1>
            <p class="page-intro">
                Each project page explains the problem, my contribution,
                the engineering process, results, and lessons learned.
            </p>
        </div>
    </section>

    <section class="section">
        <div class="project-grid">
            {
                projects.map((project, index) => (
                    <article class="project-card">
                        <p class="project-number">
                            {String(index + 1).padStart(2, "0")}
                        </p>
                        <p class="project-type">{project.category}</p>
                        <h2>{project.title}</h2>
                        <p>{project.description}</p>
                        <p class="tools">{project.tools}</p>
                        <a class="text-link" href={project.href}>
                            View project →
                        </a>
                    </article>
                ))
            }
        </div>
    </section>
</BaseLayout>
