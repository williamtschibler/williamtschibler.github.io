---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Capacitive LOX Level Sensor"
  category="Cryogenic Systems · Instrumentation · R&D"
  status="Work in progress"
  summary="Early-stage development of a custom capacitive sensor intended to measure liquid-oxygen fill level in a propellant tank."
  tools={["Capacitive Sensing", "CAD", "Cryogenic Design"]}
  team="Project lead with student team"
>
  <div class="case-study-page">
    <section class="case-study-card context-card">
      <span class="wip-label">WIP</span>
    </section>
  </div>
</ProjectLayout>

<style>
  .case-study-page {
    display: grid;
    gap: 30px;
  }

  .case-study-card {
    border: 1px solid #bfd2e5;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.72);
  }

  .context-card {
    display: grid;
    min-height: 270px;
    place-items: center;
    padding: 46px 54px;
  }

  .wip-label {
    color: var(--accent);
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  @media (max-width: 720px) {
    .context-card {
      min-height: 220px;
      padding: 30px 24px;
    }
  }
</style>
